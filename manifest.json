{
  "manifest_version": 3,
  "name": "Airdrop Eligibility Checker 2025",
  "version": "1.0.0",
  "description": "Detects real 2025-2026 airdrop eligibility - official claims only",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}