{
  "manifest_version": 3,
  "name": "Airdrop Checker 2025",
  "version": "1.0.2",
  "description": "Real & safe airdrop eligibility checker",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  }
}